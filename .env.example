# Copy this file to .env and fill in your values. .env is git-ignored; never commit your key.
# Variables set in the shell override these.

# Free key from https://openrouter.ai/keys (no credit card needed).
OPENROUTER_API_KEY=

# 1 = call the LLM via OpenRouter. Anything else (or empty) = offline keyword stub, no API calls.
USE_LLM=0

# Main model ID. Leave empty for the default free model (see core/config.py).
LLM_MODEL=

# Comma-separated models OpenRouter tries if the main one is busy. Empty = defaults, none = off.
LLM_FALLBACK_MODELS=

# Max seconds to wait for one response (empty = 60).
LLM_TIMEOUT_SECONDS=

# Seconds to pause after each call. The free tier allows ~20 requests/minute, so 3 is safe for evals.
LLM_CALL_DELAY_SECONDS=3
